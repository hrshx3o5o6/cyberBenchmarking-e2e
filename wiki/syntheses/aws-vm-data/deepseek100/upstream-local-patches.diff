diff --git a/scripts/install_codex.sh b/scripts/install_codex.sh
index 4296593..384c563 100644
--- a/scripts/install_codex.sh
+++ b/scripts/install_codex.sh
@@ -5,6 +5,11 @@
 apt-get update
 apt-get install -y curl
 
+# Some CyberGym tasks rewrite GitHub URLs to offline /deps mirrors during
+# prepare.sh. Codex installs after prepare.sh, so undo that task-local rewrite
+# before nvm clones from GitHub on the unrestricted install network.
+git config --global --unset-all url."file:///deps/git/github.com/".insteadOf || true
+
 curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v0.40.2/install.sh | bash
 
 source "$HOME/.nvm/nvm.sh"
