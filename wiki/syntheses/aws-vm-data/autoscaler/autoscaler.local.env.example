# Copy to autoscaler.local.env (git-ignored) and fill in. Never commit real values.
MAX_WORKERS=2
IDLE_MINUTES=5
SLOTS=10
HEAD_TYPE=m7i.xlarge
HEAD_DISK_GIB=100
WORKER_DISK_GIB=512
AMI_ID=ami-xxxxxxxx
KEY_NAME=ray-smoke
SUBNET_ID=subnet-xxxxxxxx
SECURITY_GROUP_ID=sg-xxxxxxxx
HEAD_INSTANCE_PROFILE_ARN=arn:aws:iam::<account>:instance-profile/<name>
SSH_KEY_PATH=~/.ssh/ray-smoke.pem
JUMP_KEY_PATH=~/.ssh/id_ed25519
JUMP_HOST=<existing VM public IP or DNS>
LOCAL_ENV_FILE=/path/to/.env
LOCAL_BEDROCK_KEY_FILE=/path/to/.bedrock_key
LOCAL_RAY_TOKEN_FILE=~/.ray/auth_token
