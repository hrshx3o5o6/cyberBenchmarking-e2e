# Copy to autoscaler.local.env (git-ignored) and fill in. Never commit real values.
MAX_WORKERS=2
IDLE_MINUTES=3
CACHE_STOPPED_NODES=false
# worker size, CPUs and slots go together; the head and the workers use the same size and 10 slots each
WORKER_TYPE=m7i.4xlarge
WORKER_CPUS=16
SLOTS=6
HEAD_TYPE=m7i.4xlarge
HEAD_CPUS=16
HEAD_SLOTS=4
HEAD_PORT=6381
# each worker gets its own volume of this size (same as the head); images pulled on demand accumulate on it
WORKER_DISK_GIB=512
AMI_ID=ami-xxxxxxxx
KEY_NAME=ray-smoke
SUBNET_ID=subnet-xxxxxxxx
SECURITY_GROUP_ID=sg-xxxxxxxx
SSH_KEY_PATH=/home/harshav/.ssh/ray-smoke.pem
LOCAL_ENV_FILE=/home/harshav/benchmark-evals/config/.env
LOCAL_BEDROCK_KEY_FILE=/home/harshav/benchmark-evals/config/.bedrock_key
LOCAL_RAY_TOKEN_FILE=/home/harshav/.ray/auth_token
LOCAL_SRC_DIR=/home/harshav/benchmark-evals/src
# the folder on the head that holds llm_shim_new.py, responses_chat.py, model_registry.py, models.toml, start_shim.sh and fetch_task_data.py
LOCAL_TOOLS_DIR=/home/harshav/benchmark-evals/tools
MANIFEST_NAME=random100-e2e.json
LOCAL_MANIFEST=/home/harshav/benchmark-evals/config/random100-e2e.json
# the model every worker's shim serves, as a registry reference (tools/models.toml)
MODEL_REF=deepseek-v4.1-flash@vertex
# "tokens" = no price known, per-key caps on tokens and requests; or "<total USD> [per-key USD]" for a priced model: "1000" = a 1000 USD safety total per node and the default 10 USD per run (the study rule), "20 5" = 20 total and 5 per run
WORKER_SHIM_CAPS=1000
# extra environment for the worker's shim, as words: the Google project and, while there is no service account, where to fetch the token
# ($RAY_HEAD_IP is the head's private address, set by Ray on each worker); for a Bedrock model this can be a harmless "SHIM_NOTE=bedrock"
WORKER_SHIM_ENV=VERTEX_PROJECT=your-gcp-project TOKEN_URL=http://$RAY_HEAD_IP:4110/token
