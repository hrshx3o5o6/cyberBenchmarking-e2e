# Copy to autoscaler.local.env (git-ignored) and fill in. Never commit real values.
MAX_WORKERS=3
IDLE_MINUTES=3
CACHE_STOPPED_NODES=false
# worker size, CPUs and slots go together (about 0.5 slots per vCPU on light patch-only tasks)
WORKER_TYPE=m7i.2xlarge
WORKER_CPUS=8
SLOTS=4
HEAD_TYPE=m7i.4xlarge
HEAD_CPUS=16
# the head also runs tasks: 4 slots for the 20-task test (it is the shared VM, keep it light)
HEAD_SLOTS=4
HEAD_PORT=6381
WORKER_DISK_GIB=150
AMI_ID=ami-xxxxxxxx
KEY_NAME=ray-smoke
SUBNET_ID=subnet-xxxxxxxx
SECURITY_GROUP_ID=sg-xxxxxxxx
SSH_KEY_PATH=/home/harshav/.ssh/ray-smoke.pem
LOCAL_ENV_FILE=/home/harshav/benchmark-evals/config/.env
LOCAL_BEDROCK_KEY_FILE=/home/harshav/benchmark-evals/config/.bedrock_key
LOCAL_RAY_TOKEN_FILE=/home/harshav/.ray/auth_token
LOCAL_SRC_DIR=/home/harshav/benchmark-evals/src
MANIFEST_NAME=smoke2.json
LOCAL_MANIFEST=/home/harshav/benchmark-evals/config/smoke2.json
LOCAL_SERVICES_SCRIPT=/home/harshav/autoscaler/start_worker_services.sh
SHIM_MODEL=us.moonshotai.kimi-k3
WORKER_SHIM_TOTAL_USD=5
